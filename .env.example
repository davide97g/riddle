# Copy to .env and fill in what you want to change. .env is
# gitignored and must never be committed: it holds the tablet's
# root password.
#
# Generated by `riddle config --example`. Every line below is the
# code's own default, commented out -- uncomment to override.

# --- device access ---
# The address every reMarkable exposes with USB web interface on. For
# logging in by hand; the code uses RM2_SSH_HOST.
# RM2_HOST=10.11.99.1

# For logging in by hand.
# RM2_USER=root

# Printed on the tablet under Settings > Help > Copyrights and licenses,
# and regenerated by major firmware updates. For logging in by hand;
# nothing here reads it.
# RM2_PASSWORD=

# The ssh alias the diary talks to. Define it in ~/.ssh/config, ideally
# with a key, so no password is ever needed.
# RM2_SSH_HOST=rm2

# The tablet's address over wifi, if it has one. Only `riddle link` uses
# it, to probe both routes.
# RM2_WIFI_HOST=

# Where the agent lives on the tablet.
# RIDDLE_AGENT=/home/root/riddle/riddled

# --- the diary ---
# Which notebook to announce at startup. Ink lands in whatever page is
# actually on screen; this is a statement of intent.
# RIDDLE_NOTEBOOK=Notebook

# Idle time after a pen lift before the diary answers.
# RIDDLE_PAUSE_MS=3000

# Which model answers. It has to be able to see -- the page is attached to
# the turn -- and it has to be quick, because the reply is two dozen words
# and the pause is already over.
# RIDDLE_OPENAI_MODEL=gpt-4.1-mini

# The OpenAI API key. Put it in .env, which is gitignored and must be
# chmod 600.
# RIDDLE_OPENAI_KEY=

# Where that API lives. Anything OpenAI-compatible that takes an image
# works, which is how a local model would be dropped in.
# RIDDLE_OPENAI_URL=https://api.openai.com/v1

# How long a reply may be. A page is small and the pen is slow.
# RIDDLE_MAX_WORDS=22

# --- the hand ---
# The hand for longer replies. A .jhf in the fonts directory is Hershey; a
# .ttf is skeletonised into a joined hand.
# RIDDLE_FONT_BODY=futural

# The hand for short replies and *emphasis* runs.
# RIDDLE_FONT_ACCENT=DancingScript

# Cap height of the diary's writing, in screen pixels.
# RIDDLE_INK_HEIGHT=72

# How hard the injected nib presses, 0-4095. Thicker ink, and xochitl is
# likelier to believe it.
# RIDDLE_PRESSURE=3200

# --- the page you speak into ---
# The store both halves write. Relative paths hang off var/.
# RIDDLE_DB=riddle.db

# Loopback on purpose: `riddle voice share` is what exposes it, and it
# does so behind a real certificate.
# RIDDLE_WEB_HOST=127.0.0.1

# The port the page is served on.
# RIDDLE_WEB_PORT=8765

# The built client. Without it the server serves a stub page and the api
# still works.
# RIDDLE_WEB_DIR=apps/web/dist

# Log every request line.
# RIDDLE_WEB_DEBUG=

# One password in front of the page. Empty means no gate, which is right
# on loopback and wrong the moment the port is published.
# RIDDLE_WEB_PASSWORD=

# The speech model, fetched once by hand. Relative paths hang off
# var/models.
# RIDDLE_ASR_MODEL=ggml-parakeet-tdt-0.6b-v3-q8_0.bin

# Threads for one parakeet run. Runs are serialised anyway: two of them
# share one Metal context and make each other slower.
# RIDDLE_ASR_THREADS=4

# The quietest thing the gate will call speech. Too low and the fridge is
# transcribed; too high and quiet speech is lost.
# RIDDLE_VAD_FLOOR=0.012

# Silence before an utterance is considered finished. Too short and
# sentences are cut mid-clause.
# RIDDLE_VAD_HANG_MS=700

# Forced cut. Somebody is monologuing.
# RIDDLE_VAD_MAX_MS=20000

# How often the live view reads the tablet's screen while a page is
# watching it. Each read is about half a second of the tablet's own CPU,
# so faster costs battery. Needs RIDDLE_ALLOW_SNAP.
# RIDDLE_LIVE_MS=1000

# How long recordings of your room stay on disk. 0 keeps them forever,
# which is a decision worth making on purpose.
# RIDDLE_AUDIO_KEEP_DAYS=7

# --- the client's build ---
# Where the dev server proxies /api and /ws. Derived from the host and
# port unless you set it.
# RIDDLE_SERVER=<derived from RIDDLE_WEB_HOST and RIDDLE_WEB_PORT>

# Dev mode behind `tailscale serve`: hot reload has to dial 443 over wss,
# because tailscale terminates the TLS.
# RIDDLE_TAILNET=

# --- safety ---
# Standing permission to put ink on whatever page is open. Leave it unset
# and pass --yes per command instead.
# RIDDLE_ALLOW_DRAW=

# Standing permission to read the tablet's screen out of another process's
# memory. Same advice.
# RIDDLE_ALLOW_SNAP=
