# Copy to .env and fill in. .env is gitignored and must never be committed:
# it holds the tablet's root password.

# --- device access ---
# 10.11.99.1 is the address every reMarkable exposes when "USB web interface"
# is on; it is not specific to your device. The password is printed on the
# tablet under Settings > Help > Copyrights and licenses, and is regenerated
# by major firmware updates.
#
# RM2_HOST/USER/PASSWORD are for logging in by hand; the code itself only uses
# RM2_SSH_HOST. Define that alias in ~/.ssh/config pointing at RM2_HOST,
# ideally with a key, so the password is never needed interactively.
RM2_HOST=10.11.99.1
RM2_USER=root
RM2_PASSWORD=
RM2_SSH_HOST=rm2

# --- diary ---
# Which notebook to announce at startup. The diary draws into whatever page is
# actually on screen; this is only a reminder of the intended target.
RIDDLE_NOTEBOOK=Notebook

# Idle time after a pen lift before the diary answers.
RIDDLE_PAUSE_MS=2500

RIDDLE_MODEL=claude-sonnet-5
RIDDLE_MAX_WORDS=40

# --- hand ---
# Hershey fonts from host/fonts/*.jhf. Body is used for longer replies,
# accent for *emphasis* runs.
RIDDLE_FONT_BODY=futural
RIDDLE_FONT_ACCENT=scripts
RIDDLE_INK_HEIGHT=28
RIDDLE_PRESSURE=2300

# --- safety ---
# Anything that draws refuses without --yes or RIDDLE_ALLOW_DRAW=1.
# Leave this unset; pass --yes per command instead.
# RIDDLE_ALLOW_DRAW=1
