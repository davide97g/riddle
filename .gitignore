# Secrets and machine-local state
.env
.riddle_session

# Device backups. Contain the tablet's private keys, shell history and every
# notebook. Never publish these.
backup/rm2-*/
backup/inventory-*/
*.zip
*.tar
*.tar.gz

# Captured pages: photographs of whatever was handwritten on the tablet.
captures/

# Build output and local tooling
bin/
.venv/

# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store
.riddle.pid
riddle.log
memories.txt

# The diary's memory: every stroke, and every word said near the microphone.
riddle.db*

# Utterances captured from the browser microphone, kept only long enough to
# re-check a transcript. A recording of your room, like captures/.
audio/

# The speech model, fetched once by hand.
models/

# The page you speak into: deps and build output. bun.lock is committed.
web/node_modules/
web/dist/
web/.vite/

# Background runners
.voice.pid
voice.log
