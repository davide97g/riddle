# Settings for the container, read by compose.yml. Copy to riddle.env (which
# is gitignored) and fill in. Every other setting in .env.example works here
# too; these are the ones a container needs.

# The page and the app sign in with this. Required: the container listens on
# every interface.
RIDDLE_WEB_PASSWORD=

# The diary's replies.
RIDDLE_OPENAI_KEY=

# The ssh alias for the tablet, as named in ssh/config beside this file.
RM2_SSH_HOST=rm2-wifi

# Live, and the diary looking at the whole page. Reads the tablet's screen.
# RIDDLE_ALLOW_SNAP=1

# No tablet at all: a demo. See compose.demo.yml.
# RIDDLE_DEMO=1
